{
  "manifest_version": 3,
  "name": "FB Unsend Message Viewer",
  "version": "1.3.0",
  "author": "binhake",
  "homepage_url": "https://github.com/binhake/fb-unsend-viewer",
  "description": "Ghi nhận ngầm và khôi phục tin nhắn bị gỡ trên Facebook ngay cả khi chuyển sang tab khác.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.fbcdn.net/*",
    "*://*.cdn.fbsbx.com/*",
    "*://*.mmg.whatsapp.net/*",
    "https://api.telegram.org/*",
    "https://api.github.com/*",
    "https://www.googleapis.com/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Xem lịch sử tin nhắn bị gỡ",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*"
      ],
      "js": [
        "injected.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.facebook.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_start"
    }
  ]
}
